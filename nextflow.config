params {
    // Core params that others might depend on 
    outputDir = "$launchDir/results"
    container = null
    containerAnnotate = null
    containerAssembly = null
    containerMag = null
    containerSkani = null
    containerSourmash = null
    containerCheckM = null
    containerHumann3 = null
    containerFastp = null
    condaEnv = null
    runId = null
    timestamp = new java.util.Date().format('yyyyMMddHHmmss')
    internetModule = null
    
    // Derived params that depend on core params
    publishDir = "${params.outputDir}/results"
    traceDir = "${params.outputDir}/pipeline_info"
    tmpDir = null  // System default if not specified
    containerCacheDir = "${params.outputDir}/container_cache"
    q2cacheDir = "${params.outputDir}/caches/main"
    q2TemporaryCachesDir = "${params.outputDir}/caches"
    additionalVolumeMounts = ""
    additionalContainerOptions = ""

    q2cacheDirExists = "ok"

    // Archiving settings
    archive = false
    archiveDir = "${params.outputDir}/archives"
    
    // Runs after every analysis, export, report, permission and archive task.
    provenance_dedup {
        enabled = false
        baseTime = '6h'
        timePerSample = '1h'
        maxTime = '72h'
        maxLinks = 10000
        ignoreMtime = false
        ignoreLustreLayout = false
    }

    // Input/output settings
    email = null
    inputReadsCache = null
    inputReads = null
    inputReadsManifest = null
    metadata = null // Sample metadata TSV for contig QC and TFA; also required with cached-read input.
    fondueAccessionIds = null

    retain {
        input = true
        subsampling = true
        fastp = true
        host_removal = true
    }

    // Default overall scaling factors
    overall_cpu_scale = 1.0
    overall_mem_scale = 1.0
    overall_time_scale = 1.0

    // Default task-specific multipliers
    cpu_intensive_task_multiplier = 1.0
    mem_intensive_task_multiplier = 1.0   

    // User-level multipliers applied on top of any profile (all labels)
    cpu_multiplier = 1.0
    mem_multiplier = 1.0
    time_multiplier = 1.0

}

includeConfig 'conf/defaults.config'    // Default values for all workflow modules
includeConfig 'conf/resources.config'   // Resource allocation
includeConfig 'conf/profiles.config'    // Profiles

// Pipeline reporting
trace {
    enabled     = true
    file        = "${params.traceDir}/${params.timestamp}_trace.txt"
}
timeline {
    enabled     = true
    file        = "${params.traceDir}/${params.timestamp}_timeline.html"
}
report {
    enabled     = true
    file        = "${params.traceDir}/${params.timestamp}_report.html"
}
dag {
    enabled     = false
    file        = "${params.traceDir}/${params.timestamp}_dag.svg"
}

// The completion barriers require stable topic channels, even with deduplication off.
// The leading ! makes an unsupported Nextflow version a startup error.
manifest {
    nextflowVersion = '!>=25.04.0'
}
