process {
  // memory amounts are total (per job)
  // (params.cpu_multiplier as double) / mem_multiplier / time_multiplier are user-level factors
  // applied on top of the scaling profiles (low/medium/high/...) to all labels

  withLabel: fondue { 
    cpus = Math.max(1, (1 * (params.cpu_multiplier as double)).round().intValue())
    memory = 4.GB * params.overall_mem_scale * (params.mem_multiplier as double)
    time = { 4.h * params.overall_time_scale * (params.time_multiplier as double) * task.attempt }
    clusterOptions = "--tmp=100G"
  }
  
  withLabel: readSimulation {
    cpus = Math.max(1, (8 * params.overall_cpu_scale * params.cpu_intensive_task_multiplier * (params.cpu_multiplier as double)).round().intValue())
    memory = { 8.GB * params.overall_mem_scale * params.mem_intensive_task_multiplier * (params.mem_multiplier as double) * task.attempt }
    time = { 4.h * params.overall_time_scale * (params.time_multiplier as double) * task.attempt }
  }

  withLabel: fastp {
    cpus = Math.max(1, (1 * (params.cpu_multiplier as double)).round().intValue())
    memory = { (6.GB * params.overall_mem_scale * (params.mem_multiplier as double)) * task.attempt }
    time = { 1.h * params.overall_time_scale * (params.time_multiplier as double) * task.attempt }
  }

  withLabel: sampleFiltering {
    cpus = Math.max(1, (1 * params.overall_cpu_scale * (params.cpu_multiplier as double)).round().intValue())
    memory = { 4.GB * (params.mem_multiplier as double) * task.attempt }
    time = { 6.h * params.overall_time_scale * (params.time_multiplier as double) * task.attempt }
  }
  
  withLabel: hostRemoval {
    cpus = Math.max(1, (4 * params.overall_cpu_scale * params.cpu_intensive_task_multiplier * (params.cpu_multiplier as double)).round().intValue())
    memory = { 8.GB * params.overall_mem_scale * (params.mem_multiplier as double) * task.attempt }
    time = { 2.h * params.overall_time_scale * (params.time_multiplier as double) * task.attempt }
  }

  withLabel: readSubsampling {
    cpus = Math.max(1, (1 * params.overall_cpu_scale * (params.cpu_multiplier as double)).round().intValue())
    memory = { 2.GB * (params.mem_multiplier as double) * task.attempt }
    time = { 4.h * params.overall_time_scale * (params.time_multiplier as double) * task.attempt }
  }

  withLabel: genomeAssembly {
    cpus = Math.max(1, (4 * params.overall_cpu_scale * (params.cpu_multiplier as double)).round().intValue())
    memory = { 12.GB * params.overall_mem_scale * params.mem_intensive_task_multiplier * (params.mem_multiplier as double) * task.attempt }
    time = { 6.h * params.overall_time_scale * (params.time_multiplier as double) * task.attempt }
  }
  
  withLabel: contigEvaluation {
    cpus = Math.max(1, (24 * params.overall_cpu_scale * params.cpu_intensive_task_multiplier * (params.cpu_multiplier as double)).round().intValue())
    memory = { 24.GB * params.overall_mem_scale * (params.mem_multiplier as double) * task.attempt }
    time = { Math.min(336, (48 * params.overall_time_scale * (params.time_multiplier as double) * task.attempt).round().intValue()).h }
  }

  withLabel: indexing {
    cpus = Math.max(1, (1 * (params.cpu_multiplier as double)).round().intValue())
    memory = { 3.GB * params.overall_mem_scale * (params.mem_multiplier as double) * task.attempt }
    time = { 2.h * params.overall_time_scale * (params.time_multiplier as double) * task.attempt }
  }

  withLabel: readMapping {
    cpus = Math.max(1, (4 * params.overall_cpu_scale * params.cpu_intensive_task_multiplier * (params.cpu_multiplier as double)).round().intValue())
    memory = { 16.GB * params.overall_mem_scale * params.mem_intensive_task_multiplier * (params.mem_multiplier as double) * task.attempt }
    time = { 6.h * params.overall_time_scale * (params.time_multiplier as double) * task.attempt }
  }
  
  withLabel: contigBinningMetabat2 {
    cpus = Math.max(1, (2 * params.overall_cpu_scale * (params.cpu_multiplier as double)).round().intValue())
    memory = { 3.GB * params.overall_mem_scale * params.mem_intensive_task_multiplier * (params.mem_multiplier as double) * task.attempt }
    time = { 4.h * params.overall_time_scale * (params.time_multiplier as double) * task.attempt }
  }

  withLabel: contigBinningSemibin2 {
    cpus = Math.max(1, (8 * params.overall_cpu_scale * params.cpu_intensive_task_multiplier * (params.cpu_multiplier as double)).round().intValue())
    memory = { 24.GB * params.overall_mem_scale * params.mem_intensive_task_multiplier * (params.mem_multiplier as double) * task.attempt }
    time = { 12.h * params.overall_time_scale * (params.time_multiplier as double) * task.attempt }
  }

  withLabel: contigBinningVamb {
    cpus = Math.max(1, (8 * params.overall_cpu_scale * (params.cpu_multiplier as double)).round().intValue())
    memory = { 24.GB * params.overall_mem_scale * (params.mem_multiplier as double) * task.attempt }
    time = { 12.h * params.overall_time_scale * (params.time_multiplier as double) * task.attempt }
  }

  withLabel: binRefinement {
    cpus = Math.max(1, (4 * params.overall_cpu_scale * (params.cpu_multiplier as double)).round().intValue())
    memory = { 12.GB * params.overall_mem_scale * (params.mem_multiplier as double) * task.attempt }
    time = { 6.h * params.overall_time_scale * (params.time_multiplier as double) * task.attempt }
  }

  withLabel: checkm {
    cpus = Math.max(1, (6 * params.overall_cpu_scale * (params.cpu_multiplier as double)).round().intValue())
    memory = { 42.GB * params.overall_mem_scale * (params.mem_multiplier as double) * task.attempt }
    time = { (6.h * params.overall_time_scale * (params.time_multiplier as double)) * task.attempt }
  }
  
  withLabel: busco {
    cpus = Math.max(1, (4 * params.overall_cpu_scale * params.cpu_intensive_task_multiplier * (params.cpu_multiplier as double)).round().intValue())
    memory = { 3.GB * params.overall_mem_scale * (params.mem_multiplier as double) * task.attempt }
    time = { 4.h * params.overall_time_scale * (params.time_multiplier as double) * task.attempt }
  }
  
  withLabel: dereplication {
    cpus = Math.max(1, (1 * (params.cpu_multiplier as double)).round().intValue())
    memory = { 8.GB * params.overall_mem_scale * params.mem_intensive_task_multiplier * (params.mem_multiplier as double) * task.attempt }
    time = { 4.h * params.overall_time_scale * (params.time_multiplier as double) * task.attempt }
  }
  
  withLabel: abundanceEstimation {
    cpus = Math.max(1, (4 * params.overall_cpu_scale * (params.cpu_multiplier as double)).round().intValue())
    memory = { 24.GB * params.overall_mem_scale * params.mem_intensive_task_multiplier * (params.mem_multiplier as double) * task.attempt }
    time = { 6.h * params.overall_time_scale * (params.time_multiplier as double) * task.attempt }
  }

  withLabel: taxonomicClassification { 
    cpus = Math.max(1, (4 * params.overall_cpu_scale * params.cpu_intensive_task_multiplier * (params.cpu_multiplier as double)).round().intValue())
    memory = { 20.GB * params.overall_mem_scale * params.mem_intensive_task_multiplier * (params.mem_multiplier as double) * task.attempt }
    time = { 4.h * params.overall_time_scale * (params.time_multiplier as double) * task.attempt }
  }

  withLabel: taxonomicClassificationKraken2 { 
    cpus = Math.max(1, (4 * params.overall_cpu_scale * params.cpu_intensive_task_multiplier * (params.cpu_multiplier as double)).round().intValue())
    time = { 4.h * params.overall_time_scale * (params.time_multiplier as double) * task.attempt }
  }

  withLabel: taxonomicClassificationKaiju { 
    cpus = Math.max(1, (4 * params.overall_cpu_scale * params.cpu_intensive_task_multiplier * (params.cpu_multiplier as double)).round().intValue())
    time = { 4.h * params.overall_time_scale * (params.time_multiplier as double) * task.attempt }
  }

  withLabel: orthologSearch { 
    cpus = Math.max(1, (12 * params.overall_cpu_scale * params.cpu_intensive_task_multiplier * (params.cpu_multiplier as double)).round().intValue())
    time = { 24.h * params.overall_time_scale * (params.time_multiplier as double) * task.attempt }
  }

  withLabel: functionalAnnotation { 
    cpus = Math.max(1, (4 * params.overall_cpu_scale * (params.cpu_multiplier as double)).round().intValue())
    time = { 24.h * params.overall_time_scale * (params.time_multiplier as double) * task.attempt }
  }

  withLabel: humann3Profiling {
    cpus = Math.max(1, (8 * params.overall_cpu_scale * params.cpu_intensive_task_multiplier * (params.cpu_multiplier as double)).round().intValue())
    memory = { (params.humann3.memory_use == 'maximum' ? 64.GB : 24.GB) * params.overall_mem_scale * params.mem_intensive_task_multiplier * (params.mem_multiplier as double) * task.attempt }
    time = { 24.h * params.overall_time_scale * (params.time_multiplier as double) * task.attempt }
  }

  withLabel: humann3Conversion {
    cpus = Math.max(1, (1 * (params.cpu_multiplier as double)).round().intValue())
    memory = { 4.GB * params.overall_mem_scale * (params.mem_multiplier as double) * task.attempt }
    time = { 2.h * params.overall_time_scale * (params.time_multiplier as double) * task.attempt }
  }

  withLabel: collation { 
    cpus = Math.max(1, (1 * params.overall_cpu_scale * (params.cpu_multiplier as double)).round().intValue())
    memory = { 12.GB * params.overall_mem_scale * params.mem_intensive_task_multiplier * (params.mem_multiplier as double) * task.attempt }
    time = { 24.h * params.overall_time_scale * (params.time_multiplier as double) * task.attempt }
  }

  withLabel: needsInternet {
      module  = params.internetModule
  }

}
