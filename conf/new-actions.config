// Optional release exercise profile. Merge the equivalent YAML settings from
// examples/new-actions.yml into params.yml when you need to override this preset.
params {
    binning {
        enabled = true
        primary = 'das_tool'
        fetchArtifact = true
        metabat2.enabled = true
        semibin2.enabled = true
        vamb.enabled = true
        das_tool.enabled = true
    }
    functional_annotation {
        enabledFor = 'contigs,mags,derep'
        transferFromContigs = true
        tfa.enabled = true
        tfa.fetchArtifact = true
    }
    taxonomic_classification.enabledFor = 'contigs'
    taxonomic_classification.bracken.enabled = false
    taxonomic_classification.kaiju.enabledFor = ''
    abundance_estimation.enabledFor = 'contigs,derep'
    dereplication.enabled = true
}
